import pepita.*
import alpiste.*
import silvestre.*
import muro.*
import pepito.*
import direcciones.*
import wollok.game.*

program PepitaGame {
	game.title("El titulo")
	game.height(10)
	game.width(10)
	game.boardGround("fondo2.jpg")
	game.addVisual(silvestre)
	game.addVisual(pepita)
	game.addVisual(alpiste)
	game.addVisual(Muro)
	game.addVisual(pepito)

	keyboard.left().onPressDo({ pepita.mover(izquierda)})
	keyboard.right().onPressDo({ pepita.mover(derecha)})
	keyboard.up().onPressDo({ pepita.mover(arriba)})
	keyboard.down().onPressDo({ pepita.mover(abajo)})
	
	keyboard.left().onPressDo({ silvestre.mover(izquierda)})
	keyboard.right().onPressDo({ silvestre.mover(derecha)})

	game.onCollideDo(silvestre, { elemento =>
    game.say(elemento, "Opa! Me llevé puesta un gato!")})

	
	const tick = game.tick(2000, { pepita.movete(abajo) }, false)
  tick.start()

	keyboard.w().onPressDo({ 
        pepito.intentarMoverseA(arriba) 
    })

    // Mover hacia ABAJO (Resta 1 en Y)
    keyboard.s().onPressDo({ 
        pepito.intentarMoverseA(abajo) 
    })

    // Mover hacia la IZQUIERDA (Resta 1 en X)
    keyboard.a().onPressDo({ 
        pepito.intentarMoverseA(izquierda) 
    })

    // Mover hacia la DERECHA (Suma 1 en X)
    keyboard.d().onPressDo({ 
        pepito.intentarMoverseA(derecha) 
    })

	game.start()
}
